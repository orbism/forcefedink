# --- local dev ---
# Direct postgres:// URL. On Vercel, connecting Prisma Postgres provides DATABASE_URL, which is
# used automatically when DATABASE_URI is unset. (Not the prisma+postgres:// Accelerate URL.)
DATABASE_URI=postgres://user@localhost:5432/forcefedink
# Required everywhere. Generate: openssl rand -hex 32
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# --- optional locally; required in production ---
# Vercel Blob (storage). Leave blank locally to use disk storage.
BLOB_READ_WRITE_TOKEN=
# Resend (enquiry + subscribe notifications). Leave blank to log emails to console.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=
