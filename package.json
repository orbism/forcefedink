{
  "name": "forcefedink",
  "version": "0.1.0",
  "description": "Force Fed Ink — original drawings and limited numbered print drops",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3100",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3100",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3100",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "node --no-deprecation --env-file-if-exists=.env node_modules/payload/bin.js",
    "generate:types": "node --no-deprecation --env-file-if-exists=.env node_modules/payload/bin.js generate:types",
    "generate:importmap": "node --no-deprecation --env-file-if-exists=.env node_modules/payload/bin.js generate:importmap",
    "migrate": "node --no-deprecation --env-file-if-exists=.env node_modules/payload/bin.js migrate",
    "migrate:create": "node --no-deprecation --env-file-if-exists=.env node_modules/payload/bin.js migrate:create",
    "seed": "node --no-deprecation --env-file-if-exists=.env --import=tsx/esm scripts/seed.ts",
    "motif": "node scripts/ingest-motif.mjs",
    "texture": "node scripts/gen-texture.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-seo": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-vercel-blob": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.3.4",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.34.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.4.2",
    "svgo": "^4.0.0",
    "tsx": "4.22.4",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
